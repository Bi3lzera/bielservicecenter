# API Configuration
# Base URL for the Laravel API backend
VITE_API_BASE_URL=http://localhost:8000/api

# Base URL for authentication endpoints (CSRF, etc.)
VITE_API_AUTH_URL=http://localhost:8000

# Reverb WebSocket Configuration
# Application key for Reverb
VITE_REVERB_APP_KEY=helpdesk_key

# WebSocket server host
VITE_REVERB_HOST=localhost

# WebSocket server port
VITE_REVERB_PORT=8080

# WebSocket scheme (http or https)
VITE_REVERB_SCHEME=http
